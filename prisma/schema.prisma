// Wartungsplaner – Datenmodell
// Dokumentation: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Aufzählungen
// ---------------------------------------------------------------------------

enum AuthProvider {
  LOCAL
  OIDC
}

enum Role {
  ADMIN
  EDITOR
  AUDITOR
}

enum IntervalType {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  EVERY_N_DAYS
}

enum ScheduleMode {
  FIXED // fester Rhythmus ab Soll-Fälligkeit
  AFTER_COMPLETION // ab Erledigungsdatum
}

enum Criticality {
  LOW
  MEDIUM
  HIGH
}

enum OccurrenceStatus {
  OPEN
  DONE
  OVERDUE
  SUSPENDED
}

enum ExecutionResult {
  OK
  OK_WITH_REMARKS
  DEVIATION
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

// ---------------------------------------------------------------------------
// Benutzer & Stammdaten
// ---------------------------------------------------------------------------

model User {
  id                 String       @id @default(cuid())
  name               String
  email              String       @unique
  /// Leer bei reinen SSO-Konten
  passwordHash       String?
  authProvider       AuthProvider @default(LOCAL)
  role               Role         @default(AUDITOR)
  active             Boolean      @default(true)
  /// Erzwingt einen Passwortwechsel beim nächsten Login
  mustChangePassword Boolean      @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  /// Empfängt Erinnerungen und Übersichten per E-Mail
  notifyByEmail      Boolean      @default(true)

  ownedTasks          Task[]                @relation("TaskOwner")
  executions          Execution[]
  uploads             Attachment[]
  responsibleFindings Finding[]             @relation("FindingResponsible")
  auditLogs           AuditLog[]
  eskalationFuer      NotificationSetting[] @relation("EskalationsEmpfaenger")
  integritaetsLaeufe  IntegritaetsLauf[]    @relation("IntegritaetsLaeufe")
  passkeys            Passkey[]
  erfassteNachweise   Nachweis[]            @relation("NachweisErfasser")
  gepruefteNachweise  Nachweis[]            @relation("NachweisPruefer")

  @@index([role])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  /// Hex-Farbe für Ampel/Badges, z. B. "#2563eb"
  color     String   @default("#64748b")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@index([sortOrder])
}

// ---------------------------------------------------------------------------
// Aufgaben & Fälligkeiten
// ---------------------------------------------------------------------------

model Task {
  id             String       @id @default(cuid())
  title          String
  description    String?
  /// Prüfanleitung im Markdown-Format
  instructionsMd String?
  categoryId     String
  ownerId        String
  intervalType   IntervalType
  /// Nur bei EVERY_N_DAYS relevant (Anzahl Tage)
  intervalValue  Int?
  scheduleMode   ScheduleMode @default(FIXED)
  /// Datum der ersten Fälligkeit
  startDate      DateTime     @db.Date
  /// Vorlaufzeit in Tagen – ab dann gilt die Fälligkeit als "bald fällig"
  leadTimeDays   Int          @default(7)
  /// Karenztage – erst danach wird auf ÜBERFÄLLIG gesetzt
  graceDays      Int          @default(0)
  evidenceRequired Boolean    @default(false)
  criticality    Criticality  @default(MEDIUM)
  /// Bisheriger Freitext; abgelöst durch die Zuordnung `auditReferenzen`.
  /// Bleibt für einen Übergang erhalten, damit nichts verlorengeht.
  auditReference String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  category    Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  owner       User                @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  occurrences Occurrence[]
  pruefboegen PruefbogenVorlage[]
  auditReferenzen TaskAuditReferenz[]

  @@index([categoryId])
  @@index([ownerId])
  @@index([active])
}

model Occurrence {
  id              String           @id @default(cuid())
  taskId          String
  dueDate         DateTime         @db.Date
  status          OccurrenceStatus @default(OPEN)
  suspendedReason String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  task      Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  execution Execution?
  nachweise Nachweis[]

  @@unique([taskId, dueDate])
  @@index([status])
  @@index([dueDate])
}

/// Durchführung einer Fälligkeit. Nach dem Anlegen unveränderlich –
/// Korrekturen erfolgen ausschließlich als neuer, protokollierter Vorgang.
model Execution {
  id           String          @id @default(cuid())
  occurrenceId String          @unique
  executedById String
  executedAt   DateTime        @default(now())
  result       ExecutionResult
  comment      String?
  createdAt    DateTime        @default(now())

  occurrence  Occurrence   @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  executedBy  User         @relation(fields: [executedById], references: [id], onDelete: Restrict)
  attachments Attachment[]
  findings    Finding[]

  @@index([executedAt])
  @@index([result])
}

/// Datei-Nachweis zu einer Durchführung. Unveränderlich.
model Attachment {
  id String @id @default(cuid())
  /// Durchführung, an der der Nachweis hängt.
  ///
  /// Leer, solange der Beleg zu einem noch offenen Prüfbogen gehört: Der
  /// Prüfbogen entsteht vor der Durchführung. Mit dem Abschluss wird die
  /// Durchführung nachgetragen, ohne die Datei zu kopieren.
  executionId  String?
  /// Gesetzt, wenn der Beleg während eines Prüfbogens hochgeladen wurde
  nachweisId   String?
  /// Optionale Zuordnung zu einem einzelnen Prüfpunkt
  punktId      String?
  filename     String
  /// Pfad relativ zum Upload-Verzeichnis
  storedPath   String
  mimeType     String
  sizeBytes    Int
  /// SHA-256-Prüfsumme des Dateiinhalts (hex)
  sha256       String
  uploadedById String
  uploadedAt   DateTime @default(now())

  execution  Execution? @relation(fields: [executionId], references: [id], onDelete: Cascade)
  uploadedBy User       @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  /// Gesetzt, wenn dieser Anhang aus einem Prüfbogen erzeugt wurde
  nachweis   Nachweis?
  /// Prüfbogen, bei dem dieser Beleg hochgeladen wurde
  belegZu    Nachweis?        @relation("NachweisBelege", fields: [nachweisId], references: [id], onDelete: Cascade)
  punkt      PruefbogenPunkt? @relation(fields: [punktId], references: [id], onDelete: SetNull)

  @@index([executionId])
  @@index([nachweisId])
  @@index([sha256])
}

model Finding {
  id             String        @id @default(cuid())
  executionId    String
  title          String
  description    String?
  severity       Severity      @default(MEDIUM)
  responsibleId  String
  dueDate        DateTime      @db.Date
  status         FindingStatus @default(OPEN)
  closedAt       DateTime?
  closingComment String?
  /// Prüfpunkt, aus dessen Feststellung diese Abweichung entstanden ist
  punktId        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  execution   Execution        @relation(fields: [executionId], references: [id], onDelete: Cascade)
  responsible User             @relation("FindingResponsible", fields: [responsibleId], references: [id], onDelete: Restrict)
  punkt       PruefbogenPunkt? @relation(fields: [punktId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([responsibleId])
  @@index([dueDate])
}

// ---------------------------------------------------------------------------
// Erscheinungsbild
// ---------------------------------------------------------------------------

/// Einstellungen zum Erscheinungsbild (Farben, Logos, Bezeichnungen).
/// Bewusst als einzelner Datensatz mit fester ID "singleton" – es gibt genau
/// eine Konfiguration je Installation.
model Branding {
  id           String  @id @default("singleton")
  /// Name der Anwendung, erscheint in Kopfzeile, Titel und Reports
  appName      String  @default("Wartungsplaner")
  /// Name der Organisation, erscheint im Report-Kopf und in der Fußzeile
  organisation String  @default("")
  /// Primärfarbe als Hex (#rrggbb) – Schaltflächen, Links, Hervorhebungen
  primaryColor String  @default("#1B7CB5")
  /// Akzentfarbe als Hex (#rrggbb) – Verläufe und sekundäre Hervorhebungen
  accentColor  String  @default("#2F9BD8")
  /// Pfade relativ zum Upload-Verzeichnis; leer = mitgeliefertes Standardlogo
  logoPath     String?
  logoDarkPath String?
  faviconPath  String?
  /// Freitext für die Fußzeile der Reports (z. B. "Vertraulich – nur intern")
  reportFooter String?

  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("Branding")
}

// ---------------------------------------------------------------------------
// Nachweismodul: Prüfbögen
// ---------------------------------------------------------------------------

/// Antwortart eines Prüfpunkts.
enum PruefpunktArt {
  /// erfüllt / nicht erfüllt / entfällt
  BEWERTUNG
  /// Freitext
  TEXT
  /// Zahl
  ZAHL
  /// Datum
  DATUM
  /// Viele gleichartige Zeilen mit derselben Frage, je Zeile eine Entscheidung
  LISTE
  /// Entscheidung bei Rezertifizierungen
  ENTSCHEIDUNG
}

/// Ergebnis eines einzelnen Prüfpunkts.
enum PruefpunktErgebnis {
  ERFUELLT
  NICHT_ERFUELLT
  ENTFAELLT
  /// Rezertifizierung: Recht bleibt bestehen
  BELASSEN
  /// Rezertifizierung: Recht wird entzogen
  ENTZIEHEN
  /// Rezertifizierung: Recht wird angepasst
  AENDERN
}

/// Stand eines ausgefüllten Prüfbogens.
enum NachweisStatus {
  /// Wird gerade ausgefüllt, jederzeit änderbar
  ENTWURF
  /// Zur Gegenzeichnung vorgelegt
  VORGELEGT
  /// Gegengezeichnet und damit gültig – ab hier unveränderlich
  GEGENGEZEICHNET
  /// Mit Begründung zurückgewiesen, wieder änderbar
  ZURUECKGEWIESEN
}

/// Vorlage eines Prüfbogens. Kann einer Aufgabe fest zugeordnet sein oder
/// als allgemeine Vorlage bereitstehen.
model PruefbogenVorlage {
  id            String  @id @default(cuid())
  name          String  @unique
  beschreibung  String?
  /// Optional fest einer Aufgabe zugeordnet
  taskId        String?
  /// Muss ein Nachweis aus dieser Vorlage gegengezeichnet werden?
  vierAugen     Boolean @default(false)
  aktiv         Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?

  task      Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  punkte    PruefbogenPunkt[]
  nachweise Nachweis[]

  @@index([taskId])
}

/// Ein Prüfpunkt innerhalb einer Vorlage.
model PruefbogenPunkt {
  id         String        @id @default(cuid())
  vorlageId  String
  position   Int
  frage      String
  hinweis    String?
  art        PruefpunktArt @default(BEWERTUNG)
  /// Muss dieser Punkt beantwortet werden?
  pflicht    Boolean       @default(true)

  vorlage  PruefbogenVorlage @relation(fields: [vorlageId], references: [id], onDelete: Cascade)
  antworten NachweisAntwort[]
  belege    Attachment[]
  findings  Finding[]
  listenzeilen NachweisZeile[]

  @@unique([vorlageId, position])
  @@index([vorlageId])
}

/// Ein ausgefüllter Prüfbogen.
///
/// Gehört zu genau einer Fälligkeit. Nach der Gegenzeichnung ist er
/// unveränderlich; das erzeugte PDF wird als Nachweis an der Durchführung
/// hinterlegt.
model Nachweis {
  id           String         @id @default(cuid())
  vorlageId    String
  occurrenceId String
  status       NachweisStatus @default(ENTWURF)

  /// Zusammenfassende Bemerkung der erfassenden Person
  bemerkung String?

  erfasstById   String
  erfasstAm     DateTime  @default(now())
  vorgelegtAm   DateTime?
  /// Gegenzeichnung – darf nicht dieselbe Person wie erfasstBy sein
  geprueftById  String?
  geprueftAm    DateTime?
  /// Begründung bei Zurückweisung
  ablehnungsgrund String?

  /// Erzeugtes PDF, als Anhang an der Durchführung hinterlegt
  attachmentId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vorlage    PruefbogenVorlage @relation(fields: [vorlageId], references: [id], onDelete: Restrict)
  occurrence Occurrence        @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  erfasstBy  User              @relation("NachweisErfasser", fields: [erfasstById], references: [id], onDelete: Restrict)
  geprueftBy User?             @relation("NachweisPruefer", fields: [geprueftById], references: [id], onDelete: Restrict)
  attachment Attachment?       @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  antworten  NachweisAntwort[]
  /// Zeilen der Zeilenlisten – etwa Konten aus einem AD-Export
  zeilen     NachweisZeile[]
  /// Hochgeladene Belege (AD-Export, Screenshot, Herstellerprotokoll …)
  belege     Attachment[]      @relation("NachweisBelege")

  @@index([occurrenceId])
  @@index([status])
}

/// Antwort auf einen Prüfpunkt.
model NachweisAntwort {
  id         String              @id @default(cuid())
  nachweisId String
  punktId    String
  ergebnis   PruefpunktErgebnis?
  /// Freitext, Zahl oder Datum – je nach Art des Prüfpunkts
  wert       String?
  bemerkung  String?

  nachweis Nachweis        @relation(fields: [nachweisId], references: [id], onDelete: Cascade)
  punkt    PruefbogenPunkt @relation(fields: [punktId], references: [id], onDelete: Cascade)

  @@unique([nachweisId, punktId])
  @@index([nachweisId])
}

/// Eine Zeile einer Zeilenliste, etwa ein Konto aus einem AD-Export.
///
/// Die Zeilen gehören zum einzelnen Nachweis, nicht zur Vorlage: Welche Konten
/// oder Regeln es gibt, entscheidet sich erst beim Prüfen.
model NachweisZeile {
  id         String              @id @default(cuid())
  nachweisId String
  punktId    String
  position   Int
  /// Erste Spalte, etwa der Anmeldename
  bezeichnung String
  /// Weitere Spalten, etwa Gruppe oder Abteilung
  zusatz     String?
  ergebnis   PruefpunktErgebnis?
  bemerkung  String?

  nachweis Nachweis        @relation(fields: [nachweisId], references: [id], onDelete: Cascade)
  punkt    PruefbogenPunkt @relation(fields: [punktId], references: [id], onDelete: Cascade)

  @@unique([nachweisId, punktId, position])
  @@index([nachweisId])
  @@index([punktId])
}

// ---------------------------------------------------------------------------
// Report-Vorlagen
// ---------------------------------------------------------------------------

/// Anpassbare Vorlage für einen PDF-Report.
///
/// Je Reportart kann es mehrere Vorlagen geben; genau eine davon ist als
/// Standard gekennzeichnet und wird vorausgewählt. Ohne eigene Vorlage greift
/// die eingebaute Fassung aus `src/lib/report-vorlagen.ts`.
model ReportTemplate {
  id          String  @id @default(cuid())
  name        String
  /// compliance | historie | abweichungen | vorschau
  reportTyp   String
  istStandard Boolean @default(false)

  /// hoch oder quer
  ausrichtung String   @default("hoch")
  /// Gewählte Spalten in der gewünschten Reihenfolge
  spalten     String[] @default([])

  mitDeckblatt        Boolean @default(false)
  deckblattUntertitel String?
  /// Freitext vor der Tabelle
  einleitung          String?
  /// Freitext nach der Tabelle
  schluss             String?

  mitUnterschriften  Boolean @default(false)
  unterschriftLinks  String?
  unterschriftRechts String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@unique([reportTyp, name])
  @@index([reportTyp])
}

// ---------------------------------------------------------------------------
// Passkeys (WebAuthn)
// ---------------------------------------------------------------------------

/// Ein registrierter Passkey. Gespeichert wird ausschließlich der öffentliche
/// Schlüssel – der private Teil verlässt das Gerät des Benutzers nie.
model Passkey {
  id           String   @id @default(cuid())
  userId       String
  /// Kennung des Schlüssels, Base64URL-kodiert
  credentialId String   @unique
  /// Öffentlicher Schlüssel, Base64URL-kodiert
  publicKey    String
  /// Signaturzähler zur Erkennung geklonter Schlüssel
  counter      Int      @default(0)
  /// Übertragungswege, z. B. internal, hybrid, usb
  transports   String[] @default([])
  /// singleDevice oder multiDevice (synchronisierter Passkey)
  deviceType   String   @default("singleDevice")
  /// Wurde der Schlüssel in einem Konto gesichert?
  backedUp     Boolean  @default(false)
  /// Vom Benutzer vergebener Name, z. B. "Notebook Windows Hello"
  name         String
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum WebAuthnAbsicht {
  REGISTRIERUNG
  ANMELDUNG
}

/// Kurzlebige Aufgabe (Challenge) eines WebAuthn-Vorgangs.
///
/// Sie wird bewusst serverseitig gehalten: Läge sie nur im Browser, könnte
/// eine angreifende Person eine eigene Aufgabe vorgeben und eine früher
/// abgefangene Signatur erneut einreichen.
model WebAuthnChallenge {
  id        String          @id @default(cuid())
  challenge String
  absicht   WebAuthnAbsicht
  /// Bei der Registrierung bekannt, bei der Anmeldung noch offen
  userId    String?
  createdAt DateTime        @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Benachrichtigungen
// ---------------------------------------------------------------------------

/// Art einer versendeten Benachrichtigung.
/// Eine Audit-Referenz, etwa "ISO 27001 A.8.13" oder "TISAX 1.6.1".
///
/// Bewusst als Stammdatum statt als Freitext an der Aufgabe: Nur so lässt
/// sich verlässlich danach filtern. Als Freitext wären "ISO 27001 A.8.13" und
/// "ISO27001 A.8.13" zwei verschiedene Dinge, und genau die Frage „welche
/// Prüfungen decken diese Anforderung ab?“ bliebe unbeantwortbar.
model AuditReferenz {
  id          String  @id @default(cuid())
  /// Kurzzeichen der Anforderung, z. B. "A.8.13"
  kuerzel     String
  bezeichnung String
  /// Norm oder Rahmenwerk, z. B. "ISO 27001" oder "TISAX"
  rahmenwerk  String?
  beschreibung String?
  aktiv       Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aufgaben TaskAuditReferenz[]

  /// Innerhalb eines Rahmenwerks ist das Kurzzeichen eindeutig.
  @@unique([rahmenwerk, kuerzel])
  @@index([aktiv])
}

/// Zuordnung: Eine Aufgabe kann mehrere Anforderungen abdecken, und eine
/// Anforderung wird von mehreren Aufgaben getragen.
model TaskAuditReferenz {
  taskId     String
  referenzId String

  task     Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  referenz AuditReferenz @relation(fields: [referenzId], references: [id], onDelete: Cascade)

  @@id([taskId, referenzId])
  @@index([referenzId])
}

/// Ergebnis eines Integritätslaufs über die abgelegten Nachweise.
///
/// Die Anwendung verspricht Revisionssicherheit über Prüfsummen. Ohne einen
/// regelmäßigen Abgleich fiele ein stiller Verlust im Ablageverzeichnis erst
/// auf, wenn Jahre später jemand einen Download versucht – dann ist er nicht
/// mehr zu heilen.
model IntegritaetsLauf {
  id          String   @id @default(cuid())
  gestartetAm DateTime @default(now())
  dauerMs     Int
  /// Auslösende Person; leer beim geplanten Lauf
  ausgeloestById String?

  /// Anzahl geprüfter Nachweise
  geprueft    Int
  /// Datei fehlt im Ablageverzeichnis
  fehlend     Int
  /// Datei vorhanden, aber die Prüfsumme stimmt nicht
  abweichend  Int
  /// Datei im Ablageverzeichnis ohne Eintrag in der Datenbank
  verwaist    Int
  /// Nicht lesbar (Rechte, Datenträgerfehler)
  unlesbar    Int
  /// Einzelheiten zu den Beanstandungen
  befundeJson Json?

  ausgeloestBy User? @relation("IntegritaetsLaeufe", fields: [ausgeloestById], references: [id], onDelete: SetNull)

  @@index([gestartetAm])
}

enum NotificationKind {
  /// Sammelmail über bald fällige und überfällige Aufgaben
  AUFGABEN
  /// Sammelmail über Abweichungen mit naher oder überschrittener Frist
  ABWEICHUNGEN
  /// Eskalation überfälliger Aufgaben an eine zentrale Stelle
  ESKALATION
  /// Wöchentliche Übersicht
  WOCHENUEBERSICHT
  /// Bitte um Gegenzeichnung eines vorgelegten Prüfnachweises
  GEGENZEICHNUNG
  /// Rückmeldung an die erfassende Person nach einer Zurückweisung
  ZURUECKWEISUNG
  /// Testnachricht aus dem Administrationsbereich
  TEST
}

/// Globale Einstellungen zum E-Mail-Versand. Einzelner Datensatz mit der
/// festen ID "singleton" – analog zum Erscheinungsbild.
model NotificationSetting {
  id      String  @id @default("singleton")
  /// Hauptschalter. Ohne SMTP-Konfiguration bleibt der Versand ohnehin aus.
  enabled Boolean @default(false)

  /// Sammelmail über bald fällige und überfällige Aufgaben
  aufgabenAktiv     Boolean @default(true)
  /// Sammelmail über Abweichungen mit naher oder überschrittener Frist
  abweichungenAktiv Boolean @default(true)
  /// Vorlauf in Tagen, ab dem an eine Abweichungsfrist erinnert wird
  abweichungVorlaufTage Int @default(7)

  /// Eskalation überfälliger Aufgaben an eine zentrale Stelle
  eskalationAktiv    Boolean @default(false)
  /// Erst ab so vielen Tagen Überfälligkeit wird eskaliert
  eskalationAbTagen  Int     @default(7)
  eskalationUserId   String?

  /// Bitte um Gegenzeichnung vorgelegter Prüfnachweise
  gegenzeichnungAktiv     Boolean @default(true)
  /// Erst nach so vielen Tagen gilt eine Gegenzeichnung als wartend
  gegenzeichnungAbTagen   Int     @default(2)

  /// Wöchentliche Übersicht
  wochenuebersichtAktiv   Boolean @default(false)
  /// Wochentag der Übersicht: 1 = Montag … 7 = Sonntag
  wochenuebersichtTag     Int     @default(1)

  updatedAt   DateTime @updatedAt
  updatedById String?

  eskalationUser User? @relation("EskalationsEmpfaenger", fields: [eskalationUserId], references: [id], onDelete: SetNull)

  @@map("NotificationSetting")
}

/// Protokoll versendeter Benachrichtigungen.
///
/// Dient der Wiederholungssperre: Der eindeutige Schlüssel verhindert, dass
/// derselbe Sachverhalt mehrfach gemeldet wird, auch wenn der tägliche Job
/// mehrmals läuft.
model SentNotification {
  id         String           @id @default(cuid())
  kind       NotificationKind
  /// Fachlicher Schlüssel, z. B. "occurrence:<id>:faellig" oder "user:<id>:2026-W31"
  key        String
  recipient  String
  subject    String
  sentAt     DateTime         @default(now())
  /// Anzahl der in dieser Nachricht enthaltenen Vorgänge
  itemCount  Int              @default(0)

  @@unique([kind, key])
  @@index([sentAt])
  @@index([recipient])
}

// ---------------------------------------------------------------------------
// Revisionssicheres Protokoll
// ---------------------------------------------------------------------------

/// Append-only: Einträge werden ausschließlich eingefügt, niemals geändert
/// oder gelöscht. Zusätzlich per Datenbank-Trigger abgesichert
/// (siehe Migration "audit_log_append_only").
///
/// `onDelete: Restrict` ist bewusst gewählt: Benutzer mit Protokolleinträgen
/// dürfen nicht gelöscht werden, weil auch ein Nullsetzen der Referenz eine
/// Änderung am Protokoll wäre. Ausgeschiedene Personen werden deaktiviert.
model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  timestamp   DateTime @default(now())
  action      String
  entityType  String
  entityId    String?
  payloadJson Json?

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([timestamp])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([action])
}
