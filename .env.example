# ---------------------------------------------------------------------------
# Wartungsplaner – Beispielkonfiguration
# Diese Datei nach ".env" kopieren und die Werte anpassen.
# Die ".env" wird NICHT ins Git-Repository übernommen.
# ---------------------------------------------------------------------------

# --- Datenbank -------------------------------------------------------------
# Zugangsdaten für den Postgres-Container (Service "db")
POSTGRES_USER=wartungsplaner
POSTGRES_PASSWORD=bitte-aendern-sicheres-passwort
POSTGRES_DB=wartungsplaner

# Verbindungs-URL für Werkzeuge, die vom Host aus laufen (prisma migrate,
# npm run db:seed, psql, pg_dump). Der App-Container bildet seine eigene URL
# mit dem Servicenamen "db" (siehe docker-compose.yml) und nutzt diese Zeile nicht.
# Achtung: Sonderzeichen im Passwort müssen URL-kodiert werden (@ -> %40).
DATABASE_URL=postgresql://wartungsplaner:bitte-aendern-sicheres-passwort@localhost:5432/wartungsplaner?schema=public

# Port, unter dem Postgres auf dem Host erreichbar ist (nur für Debugging/Backups)
POSTGRES_PORT=5432

# --- Anwendung -------------------------------------------------------------
# Öffentlich erreichbare Basis-URL der Anwendung (ohne abschließenden Slash)
APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# Port, unter dem die Anwendung auf dem Host erreichbar ist
APP_PORT=3000

# Zufälliges Geheimnis für die Session-Cookies.
# Erzeugen mit:  openssl rand -base64 32
AUTH_SECRET=bitte-aendern-mindestens-32-zeichen-zufall

# Vertraue dem Reverse-Proxy (X-Forwarded-*). Hinter nginx/Traefik auf "true" setzen.
AUTH_TRUST_HOST=true

# Zeitzone der Anwendung
TZ=Europe/Berlin

# --- Datei-Uploads ---------------------------------------------------------
# Verzeichnis im Container, in das Nachweise abgelegt werden (Docker-Volume)
UPLOAD_DIR=/app/uploads

# --- Hintergrundjob (Fälligkeiten) ----------------------------------------
# Cron-Ausdruck für den täglichen Job (Standard: täglich 02:15 Uhr)
CRON_SCHEDULE=15 2 * * *
# Hintergrundjob aktivieren (im Container "true", bei lokaler Entwicklung optional)
CRON_ENABLED=true
# Optionales Token, um den Job zusätzlich per HTTP auszulösen:
#   curl -H "Authorization: Bearer <token>" http://localhost:3000/api/cron
CRON_TOKEN=

# --- Optional: E-Mail-Benachrichtigungen -----------------------------------
# Der Versand ist nur aktiv, wenn SMTP_HOST gesetzt ist UND die
# Benachrichtigungen unter Administration -> Benachrichtigungen
# eingeschaltet wurden.
SMTP_HOST=
SMTP_PORT=587
# true bei Port 465 (durchgehend TLS), false bei 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Absender, gern mit Anzeigename
SMTP_FROM=Wartungsplaner <wartungsplaner@firma.de>
# Nur für interne Mailserver mit selbstsigniertem Zertifikat auf false setzen
SMTP_REJECT_UNAUTHORIZED=true

# Zeitplan für den Versand (Standard: werktäglich 07:00 Uhr).
# Bewusst später als der Fälligkeitsabgleich, damit dessen Ergebnis einfließt.
MAIL_CRON_SCHEDULE=0 7 * * *

# --- Erst-Login ------------------------------------------------------------
# Startpasswort des per Seed angelegten Administrators (admin@example.com).
# Muss beim ersten Login geändert werden.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Start!1234

# --- Optional: OIDC / SSO (Entra ID, Keycloak, …) --------------------------
# Der SSO-Button erscheint nur, wenn ALLE drei Variablen gesetzt sind.
# Redirect-URI beim Identity Provider eintragen:
#   <APP_URL>/api/auth/callback/oidc
# Beispiel Entra ID:
#   OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# Beispiel Keycloak:
#   OIDC_ISSUER=https://keycloak.example.com/realms/<realm>
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Anzeigename des SSO-Buttons auf der Login-Seite
OIDC_NAME=Unternehmens-SSO
# Angeforderte Scopes (Standard reicht für die meisten Provider)
OIDC_SCOPES=openid profile email
