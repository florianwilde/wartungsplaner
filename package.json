{
  "name": "wartungsplaner",
  "version": "1.11.0",
  "private": true,
  "license": "MIT",
  "author": "Florian Wilde IT SysOp",
  "description": "Planung und revisionssichere Nachweisführung wiederkehrender IT-Prüf- und Wartungsaufgaben",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "tsx scripts/integrationstest.ts",
    "test:nachweise": "tsx scripts/nachweistest.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test:integritaet": "tsx scripts/integritaetstest.ts",
    "test:aufbewahrung": "tsx scripts/aufbewahrungstest.ts",
    "test:viren": "tsx scripts/virentest.ts",
    "test:vertretung": "tsx scripts/vertretungstest.ts",
    "test:duplizieren": "tsx scripts/duplizierungstest.ts",
    "test:import": "tsx scripts/importtest.ts",
    "test:erzwingen": "tsx scripts/erzwingentest.ts",
    "test:kalender": "tsx scripts/kalendertest.ts",
    "test:logo": "tsx scripts/logotest.ts",
    "test:ausgabe": "tsx scripts/ausgabetest.ts",
    "test:beispiele": "tsx scripts/pruefe-beispieldateien.ts",
    "test:einspielen": "bash scripts/einspieltest.sh",
    "test:migrationen": "bash scripts/migrationstest.sh",
    "test:e2e": "playwright test",
    "screenshots": "bash scripts/screenshots.sh",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pruefen": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "^0.35.5",
    "uuid": "^11.1.1",
    "next-auth": {
      "nodemailer": "$nodemailer"
    }
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@radix-ui/react-checkbox": "^1.1.4",
